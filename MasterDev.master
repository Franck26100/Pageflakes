                s.src = "/Pageflakes/log.ashx?" + encodeURIComponent(window.navigator.userAgent);
                document.body.appendChild(s);
                // 2. Afficher le message de confirmation
            if (confirm("There has been an error loading the page. Would you please take a minute and report the problem in our forum so that we can try to fix this?")) {
                document.location.href = "http://forums.Pageflakes.com/";
                }

            }
            else {
            $DC(function () { SearchForm.init(); });
            if (typeof StartPage != "undefined") $DC(function () { if (StartPage) StartPage.init(); });
            }
        </script>

        <script type="text/javascript" src="/Pageflakes/f.axd?s=PostFramework&t=j&v=213"></script>
        <script id="PostFrameworkLoaderScript" type="text/javascript">
            var PostFrameworkLoader =
            {
                load: function () {
                    PF.addScript('PostFrameworkScriptSource', '/Pageflakes/f.axd?s=PostFramework&t=j&v=213en');
                }
            };
        </script>

        <script type="text/javascript">
        // Loader PostFramework
            var PostFrameworkLoader = {
                load: function () {
                    PF.addScript('PostFrameworkScriptSource','/Pageflakes/f.axd?s=PostFramework&t=j&v=213&lang=en');
                    console.log("PostFrameworkLoader: injection PostFramework déclenchée");
                }
            };
        </script>
        <asp:ContentPlaceHolder ID="PlaceHolder_Login_Register" runat="server">
        </asp:ContentPlaceHolder>
        <script type="text/javascript">
            // Implémentation minimale de PrimaryFramework.init
            var PrimaryFramework = {
                init: function () {
                    try {
                        if (typeof PostFrameworkLoader !== "undefined") {
                            PostFrameworkLoader.load();
                        }
                    } catch (ex) {
                        console.error("PrimaryFramework.init error:", ex);
                    }
                }
            };
        </script>


        <asp:ContentPlaceHolder id="ContentGA" runat="server">
        </asp:ContentPlaceHolder>
        
        <script id="CheckForDOMReady" type="text/javascript" defer>
            (function () {
                function domReady() {
                    window.DOMReady = true;
                }

                // Navigateur moderne : DOMContentLoaded
                if (document.readyState === "loading") {
                    document.addEventListener("DOMContentLoaded", domReady, false);
                } else {
                    // DOM déjà prêt
                    domReady();
                }
            })();
        </script>
        <asp:ContentPlaceHolder id="PlaceHolderAutre" runat="server">    
        </asp:ContentPlaceHolder>
        <asp:ContentPlaceHolder ID="PlaceHolder_Fin_Script" runat="server">            
        </asp:ContentPlaceHolder>
        
        
        <!--- PlaceHolder StartPage -->
        <asp:ContentPlaceHolder ID="StartUpJSON" runat="server"></asp:ContentPlaceHolder>
        <asp:ContentPlaceHolder ID="Content_Page_Content" runat="server">
        </asp:ContentPlaceHolder>
        <asp:ContentPlaceHolder ID="Script_Page_Content" runat="server">
        </asp:ContentPlaceHolder>
                         
