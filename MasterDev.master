    <script type="text/javascript">
            // --- Hook XMLHttpRequest ---
        (function(open, send) {
            XMLHttpRequest.prototype.open = function(method, url) {
                this._url = url;
                this._method = method;
                return open.apply(this, arguments);
            };
            XMLHttpRequest.prototype.send = function(body) {
                var self = this;
                console.log("[Framework XHR REQUEST]", self._method, self._url, body || {});
                self.addEventListener("load", function() {
                    console.log("[Framework XHR RESPONSE]", self._url, self.status);
                    // décommente pour voir le contenu complet :
                    // console.log(self.responseText);
                });
                self.addEventListener("error", function() {
                    console.error("[Framework XHR ERROR]", self._url, self.status);
                });
            return send.apply(this, arguments);
            };
        })(XMLHttpRequest.prototype.open, XMLHttpRequest.prototype.send);
        // --- Hook fetch ---
        (function(fetch) {
            window.fetch = function() {
                var url = arguments[0];
                console.log("[Framework FETCH REQUEST]", url, arguments[1] || {});
                return fetch.apply(this, arguments).then(function(resp) {
                    console.log("[Framework FETCH RESPONSE]", url, resp.status);
                    // décommente pour voir le contenu complet :
                    // resp.clone().text().then(function(txt) { console.log(txt); });
                return resp;
                }).catch(function(err) {
                    console.error("[Framework FETCH ERROR]", url, err);
                    throw err;
                });
            };
        })(window.fetch);

        // --- Hook des méthodes internes App.* ---
        document.addEventListener("DOMContentLoaded", function() {
            if (window.App) {
                function hookMethod(obj, name) {
                    if (obj && typeof obj[name] === "function") {
                        var orig = obj[name];
                        obj[name] = function() {
                            console.log("[Framework INTERNAL]", name, "called", arguments);
                            return orig.apply(this, arguments);
                        };
                    }
                }
                hookMethod(App, "startup");
                hookMethod(App, "showPageflakes");
                hookMethod(App, "setPage");
                hookMethod(App, "showPage");
                // ajoute d’autres méthodes si besoin
            }
        });
    </script>

    <script type="text/javascript">
        // --- Hook XMLHttpRequest ---
        (function(open, send) {
            XMLHttpRequest.prototype.open = function(method, url) {
                this._url = url;
                this._method = method;
                return open.apply(this, arguments);
            };
            XMLHttpRequest.prototype.send = function(body) {
                var self = this;
                console.log("[Framework XHR REQUEST]", self._method, self._url, body || {});
                self.addEventListener("load", function() {
                    console.log("[Framework XHR RESPONSE]", self._url, self.status);
                    // si tu veux voir le contenu complet :
                    // console.log(self.responseText);
                });
                self.addEventListener("error", function() {
                    console.error("[Framework XHR ERROR]", self._url, self.status);
                });
                return send.apply(this, arguments);
            };
        })(XMLHttpRequest.prototype.open, XMLHttpRequest.prototype.send);

        // --- Hook fetch ---
        (function(fetch) {
            window.fetch = function() {
                var url = arguments[0];
                console.log("[Framework FETCH REQUEST]", url, arguments[1] || {});
                return fetch.apply(this, arguments).then(function(resp) {
                    console.log("[Framework FETCH RESPONSE]", url, resp.status);
                    // si tu veux voir le contenu complet :
                    // resp.clone().text().then(function(txt) { console.log(txt); });
                    return resp;
                }).catch(function(err) {
                    console.error("[Framework FETCH ERROR]", url, err);
                    throw err;
                });
            };
        })(window.fetch);
    </script>

