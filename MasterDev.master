        <script type="text/javascript" id="StartupJSON">
            // Affiche la barre avant de lancer le chargement
            document.getElementById("PageLoadProgress").style.display = "block";

            var s = document.createElement("script");
            s.type = "text/javascript";
            s.src = "/Pageflakes/GetJSON.ashx?r=634135175139218755";
            s.onload = function () {
                console.log("GetJSON chargé, startupInfo:", window.startupInfo);

                // Cache la barre une fois le JSON chargé
                document.getElementById("PageLoadProgress").style.display = "none";

                // Signal : le JSON est prêt
                window.jsonReady = true;
            };
            document.body.appendChild(s);
        </script>

        <script src="/Pageflakes/f.axd?s=Framework&t=j&v=213&lang=en" type="text/javascript"></script>
        <script type="text/javascript">
            if (typeof Sys == "undefined" || typeof App == "undefined" || typeof PrimaryFramework == "undefined") {
                // 1. Créer dynamiquement le script
                var s = document.createElement("script");
