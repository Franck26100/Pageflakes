<asp:Content ContentPlaceHolderID="PlaceHolderGetJSON"  runat="server">
    
    <script type="text/javascript" id="StartupJSON">
        var s = document.createElement("script");
        s.type = "text/javascript";
        s.src = "/Pageflakes/GetJSON.ashx?r=634135175139218750";
        s.onload = function () {
            console.log("GetJSON chargé, startupInfo:", window.startupInfo);
            if (window.startupInfo) {
                App.startup();
            }
        };
        document.body.appendChild(s);
</script>
    


</asp:Content>

<asp:Content ContentPlaceHolderID="PlaceHolderPostFram" runat="server">
    <script type="text/javascript">
        if (typeof Sys == "undefined"|| typeof App == "undefined"|| typeof PrimaryFramework == "undefined") {
            // 1. Créer dynamiquement le script
            var s = document.createElement("script");
            s.type = "text/javascript";
            s.src = "test/log.ashx?" + encodeURIComponent(window.navigator.userAgent);
            document.body.appendChild(s);
            // 2. Afficher le message de confirmation
            if (confirm("There has been an error loading the page. Would you please take a minute and report the problem in our forum so that we can try to fix this?")) {
            document.location.href = "http://forums.pageflakes.com/";}

        }
        else {
            $DC(function () { SearchForm.init(); });
            if (typeof StartPage != "undefined") $DC(function () { if (StartPage) StartPage.init(); });
        }
</script>

