                    <asp:Panel ID="MainHolder_flakeControl_rightControl_searchPanel" runat="server">
                        <script type="text/javascript" id="searchScript">
                            window.document.onkeydown = ignoreEnter;

                            function ignoreEnter(e) {
                                //if(!e) e = window.event;
                                e = $fix(e);

                                var ctr = document.getElementById('MainHolder_flakeControl_rightControl_searchControl_txtSearch');
                                if (e.keyCode == 13) {
                                    //alert(e.target.id);
                                    //alert(ctr.id);
                                    if (e.target == ctr) {
                                        return false;
                                    }
                                }

                                return true;
                            }

                            function submitSearch(e) {
                                if (!e) e = window.event;

                                if (e.which || e.keyCode) {
                                    if ((e.which == 13) || (e.keyCode == 13)) {
                                        var ctr = document.getElementById('MainHolder_flakeControl_rightControl_searchControl_btnSearch');    //('ctl00_MainHolder_flakeControl_rightControl_searchControl_buttonSearch');    
                                        var textbox = document.getElementById('MainHolder_flakeControl_rightControl_searchControl_txtSearch');
                                        // if the textbox is blank then dont do the post back.    
                                        if (typeof ctr != 'undefined' && textbox.value != '') {
                                            ctr.click();
                                            return false;
                                        }
                                    }
                                }
                            }
                        </script>
                        <h3>Search</h3>
                        <div class="search_box">
                            <span style="vertical-align:middle">
                                <input runat="server" name="$MainHolder$flakeControl$rightControl$searchControl$txtSearch" type="text" id="MainHolder_flakeControl_rightControl_searchControl_txtSearch" class="search_field" onkeydown="submitSearch(event)" />
                                <input runat="server" name="$MainHolder$flakeControl$rightControl$searchControl$btnSearch" type="submit" id="MainHolder_flakeControl_rightControl_searchControl_btnSearch" class="search_button" value="Search" onclick="javascript:WebForm_DoPostBackWithOptions(new WebForm_PostBackOptions(&quot;$MainHolder$flakeControl$rightControl$searchControl$btnSearch&quot;, &quot;&quot;, true, &quot;&quot;, &quot;&quot;, false, false))" />
                            </span>
                        </div>
                        <asp:Panel ID="MainHolder_flakeControl_rightControl_searchControl_criteriaPanel" CssClass="search_criteria" runat="server">                            
                            <h3><asp:Label ID="MainHolder_flakeControl_rightControl_searchControl_headerText" runat="server">Filter By Flake Type</asp:Label></h3>
