<script type="text/javascript">
var ua = navigator.userAgent.toLowerCase();
function resetImageTop(frameHeight, frameWidth, img)
{
    if(ua.indexOf("msie")!=-1)
    {
        setTimeout( function()
        {
            resetImageTop2(frameHeight, frameWidth, img);
        }, 80);
    }
    else
    {
        resetImageTop2(frameHeight, frameWidth, img);
    }
}

function resetImageTop2(frameHeight, frameWidth, img)
{
    // Image height should not be 0. But IE6 sometimes return that when images 
    // get loaded from cache
    if( img.height != 0 )
    {
        if( img.height < frameHeight )
        {
            var topPadding = (frameHeight - img.height)/2;
            img.style.marginTop = topPadding + "px";
        }
    }
    
    var leftPadding = 0;
    if( img.width != 0 )
    {
        if( img.width < frameWidth )
        {
            leftPadding = (frameWidth - img.width)/2;
            img.style.marginLeft = leftPadding + "px";
        }
    }
    
    // UI hack for IE
    if (navigator.appVersion.indexOf("MSIE")!=-1)
        img.style.marginLeft = leftPadding + 7 + "px";
}
</script>



  
    
    
   	


<script language="javascript" type="text/javascript">
function addFlakeContent(elementId, addFlakeURL, homeURL)
{    
    var pnlAdd = $get(elementId);
   
    pnlAdd.className = "flakeAddedPreviewText";    
    pnlAdd.innerHTML = '<em>Adding flake...<br />Please wait...</em>';   
    
    // Create the WebRequest object.
    var wRequest =  new Sys.Net.WebRequest();
    
    // Set the request Url.  
    wRequest.set_url(addFlakeURL);
    // Set the request verb.
    wRequest.set_httpVerb("GET");
    // Set the Completed event handler, 
    // for processing return data
    wRequest.add_completed(function(sender, eventArgs)
    {
        pnlAdd.innerHTML = 'Flake added. Continue or <a style="color:Navy" href="' + homeURL + '" ><br/>Go to your page</a>'; 
    });
    // Make the request.
    wRequest.invoke();
}
function positionImage(elementId)
{
    var element = $get(elementId);
    
    var width = element.offsetWidth;
    var height = element.offsetHeight;
   
   // failsafe check for image boundary
   if (width > 80)
   {
        element.height = height = (height / width )  * 80;
        element.width = width = 80;
   }
   
    var left = (80 - width) / 2;
    var top= (80 - height) / 2;

    element.style.top = top + "px";
    element.style.left = left + "px";     
 }


</script>




