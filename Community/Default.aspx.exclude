            <script type="text/javascript">
                function reloadPage(elementId, homeurl) {
                    var element = $get(elementId);
                    var url = '';
                    var sortByParam = "Sort=" + element.value;
                    if (homeurl.indexOf('?') > 0) {
                        url = homeurl + '&' + sortByParam;
                    }
                    else {
                        url = homeurl + '?' + sortByParam;
                    }
                    document.location.href = url;
                }
            </script>
        
     

                    
