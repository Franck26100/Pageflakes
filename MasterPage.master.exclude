    <script id="CheckForDOMReady" type="text/javascript">
        function domReady() { window.DOMReady = true; }
        if (Browser.isFirefox) {
            document.addEventListener("DOMContentLoaded", domReady, false);
        }
        else if (Browser.isIE) {
            var contentloadtag = document.createElement("script");
            contentloadtag.type = "text/javascript";
            contentloadtag.id = "contentloadtag";
            contentloadtag.defer = true;
            contentloadtag.src = "javascript:void(0)";
            document.body.appendChild(contentloadtag);

            contentloadtag.onreadystatechange = function () {
                if (this.readyState == "complete") domReady();
            };
        }

        else {
            domReady();
        }
    </script>  
