                    position: absolute; left: 0px; top: 0px; z-index: 50001; -moz-opacity: 0; opacity: 0;
                    filter: alpha(opacity=0); cursor: wait" onclick="return false" onmousedown="return false"
                    onmousemove="return false" onmouseup="return false" ondblclick="return false">
                    &nbsp;
                </div>      
