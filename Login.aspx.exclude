<%@ Page Language="C#" AutoEventWireup="true" CodeFile="Login.aspx.cs" Inherits="Pageflakes.Login" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Pageflakes - Connexion</title>
    <script type="text/javascript">
        var SITE_PREFIX = "http://localhost/Pageflakes/";
        var IMAGE_PREFIX = "http://localhost/Pageflakes/images/";
    </script>
    <script src="script/Framework.js" type="text/javascript"></script>
    <script src="script/LoginWizard.js" type="text/javascript"></script>
    <link href="styles/site.css" rel="stylesheet" />
    
</head>
<body>
    <form id="form1" runat="server">
        <!-- Zone de login -->
        <div id="LoginWizard_LoginBox">
            <h2>Connexion</h2>

            <input type="hidden" id="returnUrlFromLogin" name="returnUrlFromLogin" />

            <label for="LoginWizard_EmailField">Email :</label>
            <input type="text" id="LoginWizard_EmailField" />
            <span id="LoginWizard_Email_Msg"></span>
            <br />

            <label for="LoginWizard_PasswordField">Mot de passe :</label>
            <input type="password" id="LoginWizard_PasswordField" />
            <span id="LoginWizard_Password_Msg"></span>
            <br />

            <label>
                <input type="checkbox" id="LoginWizard_RememberMe" /> Se souvenir de moi
            </label>
            <br />

            <button type="button" onclick="LW.login(true)">Se connecter</button>
        </div>

        <!-- Indicateur de progression -->
        <div id="LoginWizard_LoginWorking" style="display:none;">
            <p>Connexion en cours...</p>
        </div>

        <!-- Zone de récupération de mot de passe -->
        <div id="LoginWizard_GetPasswordBox">
            <h2>Mot de passe oublié</h2>

            <label for="LoginWizard_GetPassword_Email_Field">Email :</label>
            <input type="text" id="LoginWizard_GetPassword_Email_Field" />
            <span id="LoginWizard_GetPass_Email_Msg"></span>
            <br />

            <button type="button" onclick="LW.getPassword()">Récupérer mon mot de passe</button>
            <div id="GetPasswordProgress" style="display:none;">Envoi en cours...</div>
            <div id="LoginWizard_GetPasswordMessage" style="display:none;"></div>
        </div>
    </form>
</body>
</html>
